# Dependances (toutes profondeurs, y compris la racine)
node_modules/
# Frontend
frontend/node_modules
frontend/dist
frontend/.vite
frontend/*.tsbuildinfo
frontend/*.js
frontend/*.d.ts

# Backend
server/node_modules
server/dist
server/*.tsbuildinfo

# Rapports de couverture (vitest)
coverage/
frontend/coverage
server/coverage

# Env files
# Tout fichier d'environnement reste hors du depot (le sujet fait echouer
# le projet si un secret est expose); seul .env.example est versionne.
.env*
!.env.example

# macOS
.DS_Store
graphify-out/
.graphifyignore

AGENTS.md
