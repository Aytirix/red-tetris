#frontend
PORT_DEV_FRONTEND=5173

HOST=0.0.0.0
PORT=3000
NODE_ENV=development

# Origines autorisees par CORS (HTTP) ET par socket.io, separees par des virgules.
# Non definie, on retombe sur http://localhost:${PORT_DEV_FRONTEND} — correct en dev,
# a renseigner avec le domaine reel en production.
# Sans impact tant que le serveur Node sert lui-meme la SPA (meme origine, donc pas
# de CORS), mais indispensable des qu'un front est servi depuis un autre domaine.
# LAISSEE COMMENTEE volontairement: docker-compose interpole ce fichier, une valeur
# de dev copiee telle quelle figerait le CORS de production sur localhost.
#FRONTEND_ORIGIN=https://mon-domaine.example

POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=your_database_name
POSTGRES_PORT=5432
POSTGRES_HOST=db

PGADMIN_PORT=8080
PGADMIN_DEFAULT_EMAIL=your_admin_email@example.com
PGADMIN_DEFAULT_PASSWORD=your_admin_password

DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public